          "body": "[\n  {\n    \"id\": 1,\n    \"titulo\": \"City Tour Centro Histórico\",\n    \"descripcion\": \"Recorrido guiado por el centro histórico\",\n    \"destinoId\": 1,\n    \"destinoNombre\": \"Lima\",\n    \"tipoPaseoId\": 2,\n    \"tipoPaseoNombre\": \"Cultural\",\n    \"precio\": 150.00,\n    \"moneda\": \"PEN\",\n    \"duracionDias\": 1,\n    \"cuposDisponibles\": 20,\n    \"cuposReservados\": 5,\n    \"cuposActuales\": 15,\n    \"estadoActivo\": true,\n    \"fechaCreacion\": \"2026-05-25T01:10:20\",\n    \"fechaActualizacion\": \"2026-05-25T01:10:20\"\n  }\n]"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "if (Array.isArray(data) && data.length > 0) {",
              "  pm.collectionVariables.set('paqueteId', data[0].id);",
              "  pm.collectionVariables.set('montoTotal', data[0].precio);",
              "  pm.collectionVariables.set('moneda', data[0].moneda);",
              "}"
            ]
          }
        }
      ]
